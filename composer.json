{
    "name": "jeffersongoncalves/laravel-mention-me",
    "description": "Mention Me referral marketing API integration for Laravel",
    "keywords": [
        "laravel",
        "mention-me",
        "mentionme",
        "referral",
        "referral-marketing",
        "api",
        "client"
    ],
    "homepage": "https://github.com/jeffersongoncalves/laravel-mention-me",
    "license": "MIT",
    "authors": [
        {
            "name": "Jefferson Simão Gonçalves",
            "email": "gerson.simao.92@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.21",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\LaravelMentionMe\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\LaravelMentionMe\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\LaravelMentionMe\\LaravelMentionMeServiceProvider"
            ],
            "aliases": {
                "MentionMe": "JeffersonGoncalves\\LaravelMentionMe\\Facades\\MentionMe"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
